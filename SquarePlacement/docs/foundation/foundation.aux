\@writefile{toc}{\contentsline {section}{\numberline {1}What are .conditions?}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The block above-left of $y=(3,3)$ covers the marked pixel. Each of its three other corners gets one blocker, a cell diagonal to that corner (dashed arrows).}}{1}{figure.caption.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Placing (choosing) a cell}{2}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces $p=(4,4)$ chosen on a 9$\times $9 vacuum board. Its square covers the four marked pixels. Its four diagonal neighbours are blocked.}}{2}{figure.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}The four blocked cells of a placed cell}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces After $p=(4,4)$: $q=(3,3)$ is one of its four blocked cells. The vacuum term $\ensuremath  {\{(0,0),(1,0),(3,3)\}}$ of $v=(1,2)$ needed $q$ chosen. It is gone.}}{3}{figure.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}A blocked 2x2 block, and why it is impossible}{3}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Left, hypothetical: the pinwheel $(3,1),(1,2),(2,4),(4,3)$ blocks all four cells around pixel $(3,3)$; no cell can cover it. Right, what actually happens: after three of the blockers, $(3,3)$ is a seat and is chosen (section 5), which blocks the fourth blocker $(2,4)$.}}{3}{figure.caption.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Seat rule and forcing, versus collapse and links}{4}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces One condition of $y=(3,3)$ collapsing. In the third frame a second term of $y$ gives the link $(4,1)\to y$ as well.}}{4}{figure.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Paths and aliasing}{5}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Left: chosen $(2,7),(5,7),(8,6)$. The links leaving $Z=(5,4)$: $Z\to (3,5)$, $Z\to (7,6)$, and $(7,6)\rightleftarrows (7,8)$, which force each other. Right: why $Z\to (3,5)$. In the block around pixel $(4,6)$, $(2,7)$ blocks $(3,6)$, $(5,7)$ blocks $(4,6)$, and $Z$ would block $(4,5)$.}}{5}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The same links as a graph, by distance from $Z$.}}{5}{figure.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Candidate placement and its consequence}{5}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces $Z=(5,4)$ chosen and settled. Its aliases are chosen, and 12 cells are newly blocked (red outline).}}{6}{figure.caption.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}Blocked pairs}{6}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Left: chosen $(4,5),(7,5),(8,7)$. $Z_1=(4,2)$ forces $(6,3)$; $Z_2=(7,2)$ forces $(5,3)$. The red pairs are diagonal neighbours: $(4,2)/(5,3)$ and $(6,3)/(7,2)$. Right: both links come from one block, around pixel $(6,4)$. $(4,5)$ and $(7,5)$ block two of its corners. $Z_1$ blocks $(5,3)$, so $(6,3)$ must cover the pixel; $Z_2$ blocks $(6,3)$, so $(5,3)$ must. With both, all four corners are blocked: the hole of section 4.}}{6}{figure.caption.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Refutation}{7}{section.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Left: chosen $(2,4),(2,7),(5,2)$. $Z=(5,5)$ forces $(3,4)$ and $(4,5)$, which are diagonal neighbours (red). Dashed and grey: what the links go on to derive. It includes $(4,4)$ and $(4,6)$, $Z$'s own diagonal neighbours. Right: block around pixel $(4,6)$. $(2,4)$ and $(2,7)$ block two corners, $Z$ blocks $(4,6)$, and $(3,4)$, forced by $Z$, blocks $(4,5)$: the hole.}}{7}{figure.caption.11}\protected@file@percent }
